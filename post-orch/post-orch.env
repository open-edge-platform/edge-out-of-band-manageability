#
# Edge Out-of-Band Manageability - On-Premises Environment Variables
# Usage: set -a; source post-orch.env; set +a; helmfile -e onprem-eim sync
#
# Profile options: onprem-eim, onprem-vpro
EOM_HELMFILE_ENV=onprem-vpro
# ─── Cluster Configuration ──────────────────────────────────────────────────
EOM_CLUSTER_DOMAIN=orch-10-139-218-76.pid.infra-host.com

# ─── Container Registry (single source for all chart/image/OCI/file URLs) ──
EOM_REGISTRY=registry-rs.edgeorchestration.intel.com

# ─── Storage ────────────────────────────────────────────────────────────────
EOM_STORAGE_CLASS=openebs-hostpath

# ─── Load Balancer IPs ──────────────────────────────────────────────────────
# Option 1: Single-IP mode — set EOM_ORCH_IP to share one IP for all services.
#   Traefik on :443, HAProxy on :9443
# Option 2: Multi-IP mode — set EOM_TRAEFIK_IP and EOM_HAPROXY_IP individually.
EOM_ORCH_IP=10.139.218.76
EOM_TRAEFIK_IP=10.139.218.76
EOM_HAPROXY_IP=10.139.218.76


# ─── Proxy Configuration ───────────────────────────────────────────────────
EOM_HTTP_PROXY=http://proxy-dmz.intel.com:912
EOM_HTTPS_PROXY=http://proxy-dmz.intel.com:912
EOM_NO_PROXY=maestro.intel.com,pid-coder.intel.com,caas.intel.com,linux-ftp.intel.com,pixi.intel.com,corp.intel.com,.internal,10.0.0.0/8,127.0.0.0/8,169.254.169.254,192.168.0.0/16,172.16.0.0/12,.espd.infra-host.com,.espdqa.infra-host.com,.pid.infra-host.com,localhost,.svc,.cluster.local,.default,.orch-platform,.orch-app,.orch-cluster,.orch-infra,.orch-database,.cattle-system,.orch-secret,.onprem

# ─── Edge Node Proxy Configuration ─────────────────────────────────────────
EOM_EN_HTTP_PROXY=http://proxy-dmz.intel.com:912
EOM_EN_HTTPS_PROXY=http://proxy-dmz.intel.com:912
EOM_EN_FTP_PROXY=http://proxy-dmz.intel.com:911
EOM_EN_SOCKS_PROXY=http://proxy-dmz.intel.com:1080
EOM_EN_NO_PROXY=maestro.intel.com,pid-coder.intel.com,caas.intel.com,linux-ftp.intel.com,pixi.intel.com,corp.intel.com,.internal,10.0.0.0/8,127.0.0.0/8,169.254.169.254,192.168.0.0/16,172.16.0.0/12,.espd.infra-host.com,.espdqa.infra-host.com,.pid.infra-host.com,localhost,.svc,.cluster.local,.default,.orch-platform,.orch-app,.orch-cluster,.orch-infra,.orch-database,.cattle-system,.orch-secret,.onprem

EOM_ENABLE_ISTIO=false
EOM_ENABLE_KYVERNO=false
# ─── Single Tenancy ────────────────────────────────────────────────────────
# Set to "true" to auto-create a default org, project, and tenant-admin user
EOM_DEFAULT_TENANCY=true
# EOM_AMT_PASSWORD is mandatory Eg. EOM_AMT_PASSWORD="Amt@1234"
EOM_AMT_PASSWORD="P@ssw0rd"
