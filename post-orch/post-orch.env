#
# Edge Out-of-Band Manageability - On-Premises Environment Variables
# Usage: set -a; source post-orch.env; set +a; helmfile -e onprem-eim sync
#
# Profile options: onprem-eim, onprem-vpro
EOM_HELMFILE_ENV=onprem-eim
# ─── Cluster Configuration ──────────────────────────────────────────────────
EOM_CLUSTER_DOMAIN=cluster.onprem

# ─── Container Registry (single source for all chart/image/OCI/file URLs) ──
EOM_REGISTRY=registry-rs.edgeorchestration.intel.com

# ─── Storage ────────────────────────────────────────────────────────────────
EOM_STORAGE_CLASS=openebs-hostpath

# ─── Load Balancer IPs ──────────────────────────────────────────────────────
# Option 1: Single-IP mode — set EOM_ORCH_IP to share one IP for all services.
#   Traefik on :443, HAProxy on :9443
# Option 2: Multi-IP mode — set EOM_TRAEFIK_IP and EOM_HAPROXY_IP individually.
#EOM_ORCH_IP=192.168.99.10
EOM_TRAEFIK_IP=192.168.99.30
EOM_HAPROXY_IP=192.168.99.40


# ─── Proxy Configuration ───────────────────────────────────────────────────
EOM_HTTP_PROXY=""
EOM_HTTPS_PROXY=""
EOM_NO_PROXY=""

# ─── Edge Node Proxy Configuration ─────────────────────────────────────────
EOM_EN_HTTP_PROXY=""
EOM_EN_HTTPS_PROXY=""
EOM_EN_FTP_PROXY=""
EOM_EN_SOCKS_PROXY=""
EOM_EN_NO_PROXY=""

EOM_ENABLE_ISTIO=false
EOM_ENABLE_KYVERNO=false
# ─── Single Tenancy ────────────────────────────────────────────────────────
# Set to "true" to auto-create a default org, project, and tenant-admin user
EOM_DEFAULT_TENANCY=false
# EOM_AMT_PASSWORD is mandatory Eg. EOM_AMT_PASSWORD="Amt@1234"
EOM_AMT_PASSWORD=""

# ─── Observability ─────────────────────────────────────────────────────────
# Set to "true" to enable edge node observability
EOM_ENABLE_O11Y=false
